# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_discord_server_guild_id

# Palworld Server Configuration
PALWORLD_DIR=/root/palworld-server

# Playit Tunnel Configuration
TMUX_SESSION=playit
PLAYIT_COMMAND=playit

# Testing Configuration
# Set to true to mock command execution and run the bot without actually invoking Docker, tmux, or Discord
DRY_RUN=false
